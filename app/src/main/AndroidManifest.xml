<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".AiMentorApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ASMfinal"
        android:enableOnBackInvokedCallback="true"
        tools:replace="android:label,android:theme">

        <receiver
            android:name=".utils.ReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- MainActivity Login -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ASMfinal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HomeActivity sau đăng nhập -->
        <activity
            android:name=".activities.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.ASMfinal" />

        <!-- Register -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.ASMfinal" />

        <!-- ===== MODULE PROGRAMMING ===== -->
        <activity
            android:name="com.example.modulelaptrinh.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.ModuleLapTrinh" />
        <activity
            android:name="com.example.modulelaptrinh.ProgrammingChatActivity"
            android:exported="false"
            android:theme="@style/Theme.ModuleLapTrinh" />
        <activity
            android:name="com.example.modulelaptrinh.NoteEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.ModuleLapTrinh" />

        <!-- ===== MODULE SCIENCE ===== -->
        <activity
            android:name="com.brightpath.science.presentation.ScienceMainActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.ScienceActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.ScienceHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.ScienceBookmarksActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.ScienceQuizActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.PeriodicTableActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.CircuitDiagramActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.ScienceProgressActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.ScienceSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />
        <activity
            android:name="com.brightpath.science.presentation.ScienceStudyPlannerActivity"
            android:exported="false"
            android:theme="@style/Theme.ScienceFeature" />

        <!-- ===== MODULE MATH ===== -->
        <activity
            android:name="com.example.mathmodule.MathDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.MathModule" />
        <activity
            android:name="com.example.mathmodule.MathChatActivity"
            android:exported="false"
            android:theme="@style/Theme.MathModule" />
        <activity
            android:name="com.example.mathmodule.QuizPlayActivity"
            android:exported="false"
            android:theme="@style/Theme.MathModule" />

        <!-- ===== MODULE HISTORY ===== -->
        <activity
            android:name="com.example.historymodule.HistoryDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.HistoryModule" />
        <activity
            android:name="com.example.historymodule.HistoryChatActivity"
            android:exported="false"
            android:theme="@style/Theme.HistoryModule" />
        <activity
            android:name="com.example.historymodule.HistoryQuizActivity"
            android:exported="false"
            android:theme="@style/Theme.HistoryModule" />

        <!-- FileProvider duy nhất -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource" />
        </provider>

    </application>

</manifest>