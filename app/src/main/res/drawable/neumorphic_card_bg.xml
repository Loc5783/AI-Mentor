<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Very subtle dark shadow -->
    <item android:top="2dp" android:left="2dp">
        <shape>
            <corners android:radius="32dp" />
            <solid android:color="@color/neumorphic_shadow_dark" />
        </shape>
    </item>
    <!-- White highlight -->
    <item android:bottom="3dp" android:right="3dp">
        <shape>
            <corners android:radius="32dp" />
            <solid android:color="@color/neumorphic_shadow_light" />
        </shape>
    </item>
    <!-- Main Surface -->
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape>
            <corners android:radius="32dp" />
            <solid android:color="@color/neumorphic_background" />
        </shape>
    </item>
</layer-list>