<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer highlight -->
    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="@color/neumorphic_shadow_light" />
        </shape>
    </item>
    <!-- Inner soft shadow -->
    <item android:bottom="2dp" android:right="2dp">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="@color/neumorphic_shadow_dark" />
        </shape>
    </item>
    <!-- Background -->
    <item android:top="2dp" android:left="2dp" android:bottom="1dp" android:right="1dp">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="@color/neumorphic_background" />
        </shape>
    </item>
</layer-list>