<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="132dp"
    android:layout_marginTop="4dp"
    android:background="@drawable/auth_illustration_bg"
    android:importantForAccessibility="no">

    <View
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="-24dp"
        android:background="@drawable/auth_decor_orb" />

    <View
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/auth_decor_orb_small" />

    <ImageView
        android:id="@+id/auth_brand_art"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_gravity="center"
        android:padding="14dp"
        android:background="@drawable/auth_art_card"
        android:contentDescription="@null" />
</FrameLayout>
