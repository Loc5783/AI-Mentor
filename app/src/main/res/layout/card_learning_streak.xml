<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_learning_streak" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
    app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surfaceColor" app:strokeWidth="1dp" app:strokeColor="@color/dividerColor">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageView android:id="@+id/streak_flame" android:layout_width="56dp" android:layout_height="56dp" android:padding="8dp" android:background="@drawable/streak_flame_background" android:src="@drawable/ic_streak_flame" android:contentDescription="@null" android:importantForAccessibility="no"/>
          <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/streak_title" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/textColorPrimary"/>
        </LinearLayout>
        <TextView android:id="@+id/streak_current" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/streak_loading" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/streak_flame_color" />
        <TextView android:id="@+id/streak_best" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/textColorSecondary" />
        <TextView android:id="@+id/streak_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/textColorPrimary" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/streak_milestone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textColorPrimary"/>
        <ProgressBar android:id="@+id/streak_milestone_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:progress="0" android:progressTint="@color/streak_flame_color" android:progressBackgroundTint="@color/streak_flame_container"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/streak_week" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
        <LinearLayout android:id="@+id/streak_week_days" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:baselineAligned="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/streak_rule" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/button_streak_quiz" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/streak_choose_quiz" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
