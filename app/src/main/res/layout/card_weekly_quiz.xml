<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
 app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/surfaceColor" app:strokeWidth="1dp" app:strokeColor="@color/dividerColor">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weekly_quiz_title" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/textColorPrimary" />
 <TextView android:id="@+id/weekly_quiz_xp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/streak_loading" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/primaryColor" />
 <TextView android:id="@+id/weekly_quiz_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/textColorSecondary" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/weekly_quiz_rule" android:textSize="14sp" android:textColor="@color/textColorPrimary" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/weekly_quiz_pending" android:textSize="12sp" android:textColor="@color/textColorSecondary" />
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
