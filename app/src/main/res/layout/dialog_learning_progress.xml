<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/legacy_progress_note" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            android:text="@string/overview_legacy_note" android:textSize="14sp"
            android:textColor="@color/textColorSecondary" android:visibility="gone"/>
        <include layout="@layout/card_learning_streak"/>
        <include layout="@layout/card_weekly_quiz"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
