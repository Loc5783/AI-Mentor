<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="12dp">
 <TextView android:id="@+id/chat_message_role" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/textColorSecondary" android:layout_marginBottom="5dp"/>
 <LinearLayout android:id="@+id/chat_message_files" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"/>
 <TextView android:id="@+id/chat_message_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:lineSpacingExtra="4dp" android:textColor="@color/textColorPrimary" android:textIsSelectable="true"/>
 <TextView android:id="@+id/chat_message_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/textColorSecondary" android:layout_marginTop="6dp"/>
 <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" app:singleLine="false">
  <com.google.android.material.button.MaterialButton android:id="@+id/chat_message_copy" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chat_copy" android:textSize="13sp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/chat_message_retry" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chat_retry" android:textSize="13sp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/chat_message_formula" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chat_formula" android:textSize="13sp"/>
 </com.google.android.material.chip.ChipGroup>
</LinearLayout>

