<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="180dp" android:background="@color/navHeaderColor" android:gravity="bottom" android:orientation="vertical" android:padding="16dp" android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <androidx.cardview.widget.CardView android:layout_width="80dp" android:layout_height="80dp" app:cardCornerRadius="20dp" app:cardElevation="1dp" android:layout_marginTop="8dp">

        <ImageView android:id="@+id/imgUserHeader" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="0dp" android:src="@mipmap/ic_launcher_round" android:scaleType="centerCrop" android:contentDescription="@string/nav_user_avatar" />
    </androidx.cardview.widget.CardView>

    <TextView android:id="@+id/txtUserHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/nav_user_name" android:textAppearance="@style/TextAppearance.AppCompat.Body1" android:textSize="24sp" android:textStyle="bold" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_affiliation" />

</LinearLayout>
