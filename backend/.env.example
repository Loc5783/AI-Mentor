# ==============================================================================
# AI Mentor - Cấu hình môi trường mẫu (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env trong thư mục backend nếu muốn lưu cấu hình cục bộ.
#    (Lưu ý: .env đã được .gitignore chặn để không bao giờ bị commit).
# 2. Thay thế các giá trị bên dưới bằng cấu hình thực tế của bạn.
# 3. TUYỆT ĐỐI KHÔNG điền API Key thật vào file .env.example này.
# ==============================================================================

# Loại Provider:
# - unconfigured: Không kết nối AI (mặc định an toàn cho môi trường test)
# - fake: Chế độ giả lập câu hỏi mẫu cho demo học sinh
# - gemini: Kết nối trực tiếp Google Gemini Developer API
AI_PROVIDER_TYPE=gemini

# Khóa bí mật API Key lấy từ Google AI Studio (Placeholder):
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model Gemini được cấp quyền trên tài khoản của bạn (bắt buộc khi bật gemini).
# Do chính sách Google phân quyền model theo tài khoản và dự án:
# - Tài khoản cũ có thể hỗ trợ: gemini-2.5-flash
# - Tài khoản mới khuyến nghị: gemini-3.8-flash hoặc gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Cổng và thư mục dữ liệu cục bộ (Tùy chọn):
# MENTOR_DATA_DIR=data
