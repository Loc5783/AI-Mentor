  "lessons": [
    {
      "id": "math-11-ham-so-luong-giac",
      "title": "Hàm số lượng giác và đồ thị",
      "guidance": [
        "Hàm y=sinx, y=cosx có tập xác định R, tập giá trị [-1; 1]. Hàm sinx là hàm lẻ, cosx là hàm chẵn. Chu kì tuần hoàn của sinx và cosx là 2π."
      ],
      "examples": [
        "GTLN của y = 2sinx + 1 là 3, đạt được khi sinx = 1."
      ],
      "questions": [
        {
          "id": "math-11-ham-so-luong-giac-q1",
          "difficulty": "EASY",
          "prompt": "Tập giá trị của hàm số y = cos x là?",
          "options": [
            {
              "id": "a",
              "text": "[-1; 1]"
            },
            {
              "id": "b",
              "text": "(0; 1)"
            },
            {
              "id": "c",
              "text": "R"
            }
          ],
          "correctOptionId": "a",
          "explanation": "Hàm cosx luôn nhận giá trị từ -1 đến 1."
        },
        {
          "id": "math-11-ham-so-luong-giac-q2",
          "difficulty": "MEDIUM",
          "prompt": "Chu kì tuần hoàn của hàm số y = tan x là?",
          "options": [
            {
              "id": "a",
              "text": "2π"
            },
            {
              "id": "b",
              "text": "π"
            },
            {
              "id": "c",
              "text": "π/2"
            }
          ],
          "correctOptionId": "b",
          "explanation": "Hàm số y = tan x tuần hoàn với chu kì cơ sở T = π."
        },
        {
          "id": "math-11-ham-so-luong-giac-q3",
          "difficulty": "APPLIED",
          "prompt": "Tìm GTLN của y = 3 - 2cos(x).",
          "options": [
            {
              "id": "a",
              "text": "1"
            },
            {
              "id": "b",
              "text": "5"
            },
            {
              "id": "c",
              "text": "3"
            }
          ],
          "correctOptionId": "b",
          "explanation": "Ta có -1 ≤ cosx ≤ 1, do đó GTLN của -2cosx là 2. Suy ra y ≤ 3 + 2 = 5."
        }
      ]
    },
    {
      "id": "math-11-phuong-trinh-luong-giac",
      "title": "Phương trình lượng giác cơ bản",
      "guidance": [
        "Phương trình sinx = sina có nghiệm x = a + k2π hoặc x = π - a + k2π (k thuộc Z).",
        "cosx = cosa có nghiệm x = ±a + k2π."
      ],
      "examples": [
        "Giải PT sinx = 1/2. Vì sin(π/6) = 1/2 nên x = π/6 + k2π hoặc x = 5π/6 + k2π."
      ],
      "questions": [
        {
          "id": "math-11-phuong-trinh-luong-giac-q1",
          "difficulty": "EASY",
          "prompt": "Nghiệm của phương trình cosx = 1 là?",
          "options": [
            {
              "id": "a",
              "text": "x = kπ"
            },
            {
              "id": "b",
              "text": "x = k2π"
            },
            {
              "id": "c",
              "text": "x = π/2 + kπ"
            }
          ],
          "correctOptionId": "b",
          "explanation": "cos x = 1 tại các điểm x = k2π trên đường tròn lượng giác."
        },
        {
          "id": "math-11-phuong-trinh-luong-giac-q2",
          "difficulty": "MEDIUM",
          "prompt": "Nghiệm của phương trình sinx = 0 là?",
          "options": [
            {
              "id": "a",
              "text": "x = kπ"
            },
            {
              "id": "b",
              "text": "x = k2π"
            },
            {
              "id": "c",
              "text": "Vô nghiệm"
            }
          ],
          "correctOptionId": "a",
          "explanation": "sin x = 0 tại hai điểm 0 và π trên vòng tròn, tương đương x = kπ."
        },
        {
          "id": "math-11-phuong-trinh-luong-giac-q3",
          "difficulty": "APPLIED",
          "prompt": "Số nghiệm của PT sinx = 1/2 trên đoạn [0; 2π] là?",
          "options": [
            {
              "id": "a",
              "text": "1"
            },
            {
              "id": "b",
              "text": "2"
            },
            {
              "id": "c",
              "text": "4"
            }
          ],
          "correctOptionId": "b",
          "explanation": "Trên [0; 2π], sinx = 1/2 có 2 nghiệm là π/6 và 5π/6."
        }
      ]
    },
    {
      "id": "math-11-day-so",
      "title": "Dãy số",
      "guidance": [
        "Dãy số có thể cho bằng công thức tổng quát un = f(n) hoặc bằng hệ thức truy hồi.",
        "Dãy số tăng nếu un+1 > un, giảm nếu un+1 < un với mọi n."
      ],
      "examples": [
        "Xét dãy un = 2n + 1. Ta có un+1 - un = 2(n+1)+1 - (2n+1) = 2 > 0, dãy số tăng."
      ],
      "questions": [
        {
          "id": "math-11-day-so-q1",
          "difficulty": "EASY",
          "prompt": "Cho dãy số un = 3n - 1. Số hạng u2 là?",
          "options": [
            {
              "id": "a",
              "text": "2"
            },
            {
              "id": "b",
              "text": "5"
            },
            {
              "id": "c",
              "text": "8"
            }
          ],
          "correctOptionId": "b",
          "explanation": "Thay n = 2 vào công thức: u2 = 3(2) - 1 = 5."
        },
        {
          "id": "math-11-day-so-q2",
          "difficulty": "MEDIUM",
          "prompt": "Dãy số un = 1/n là dãy số?",
          "options": [
            {
              "id": "a",
              "text": "Tăng"
            },
            {
              "id": "b",
              "text": "Giảm"
            },
            {
              "id": "c",
              "text": "Không đổi"
            }
          ],
          "correctOptionId": "b",
          "explanation": "un+1 - un = 1/(n+1) - 1/n < 0 với mọi n nguyên dương, nên dãy số giảm."
        },
        {
          "id": "math-11-day-so-q3",
          "difficulty": "APPLIED",
          "prompt": "Dãy số truy hồi u1 = 2, un+1 = 3un. Tìm u3?",
          "options": [
            {
              "id": "a",
              "text": "18"
            },
            {
              "id": "b",
              "text": "6"
            },
            {
              "id": "c",
              "text": "12"
            }
          ],
          "correctOptionId": "a",
          "explanation": "u2 = 3(u1) = 6. u3 = 3(u2) = 18."
        }
      ]
    },
    {
      "id": "math-11-cap-so-cong",
      "title": "Cấp số cộng",
      "guidance": [
        "Cấp số cộng (CSC) là dãy số thỏa mãn un+1 = un + d (d là công sai).",
        "Số hạng tổng quát: un = u1 + (n-1)d.",
        "Tổng n số hạng đầu: Sn = n(u1 + un)/2."
      ],
      "examples": [
        "CSC có u1=2, d=3 thì u4 = 2 + (4-1)3 = 11."
      ],
      "questions": [
        {
          "id": "math-11-cap-so-cong-q1",
          "difficulty": "EASY",
          "prompt": "Cho CSC có u1 = 1, d = 2. Tìm u3?",
          "options": [
            {
              "id": "a",
              "text": "3"
            },
            {
              "id": "b",
              "text": "5"
            },
            {
              "id": "c",
              "text": "7"
            }
          ],
          "correctOptionId": "b",
          "explanation": "u3 = u1 + 2d = 1 + 2(2) = 5."
        },
        {
          "id": "math-11-cap-so-cong-q2",
          "difficulty": "MEDIUM",
          "prompt": "CSC có u2 = 5, u4 = 11. Tìm d?",
          "options": [
            {
              "id": "a",
              "text": "2"
            },
            {
              "id": "b",
              "text": "3"
            },
            {
              "id": "c",
              "text": "4"
            }
          ],
          "correctOptionId": "b",
          "explanation": "Ta có u4 - u2 = 2d <=> 11 - 5 = 2d => d = 3."
        },
        {
          "id": "math-11-cap-so-cong-q3",
          "difficulty": "APPLIED",
          "prompt": "Tính tổng 10 số hạng đầu của CSC có u1 = 2, d = 3.",
          "options": [
            {
              "id": "a",
              "text": "155"
            },
            {
              "id": "b",
              "text": "165"
            },
            {
              "id": "c",
              "text": "290"
            }
          ],
          "correctOptionId": "a",
          "explanation": "S10 = 10[2u1 + 9d]/2 = 5[4 + 27] = 5*31 = 155."
        }
      ]
    },
    {
      "id": "math-11-cap-so-nhan",
      "title": "Cấp số nhân",
      "guidance": [
        "Cấp số nhân (CSN) là dãy thỏa mãn un+1 = un * q (q là công bội).",
        "Số hạng tổng quát: un = u1 * q^(n-1)."
      ],
      "examples": [
        "CSN có u1=2, q=3 thì u3 = 2 * 3^2 = 18."
      ],
      "questions": [
        {
          "id": "math-11-cap-so-nhan-q1",
          "difficulty": "EASY",
          "prompt": "Cho CSN có u1 = 3, q = 2. Tìm u2?",
          "options": [
            {
              "id": "a",
              "text": "5"
            },
            {
              "id": "b",
              "text": "6"
            },
            {
              "id": "c",
              "text": "9"
            }
          ],
          "correctOptionId": "b",
          "explanation": "u2 = u1 * q = 3 * 2 = 6."
        },
        {
          "id": "math-11-cap-so-nhan-q2",
          "difficulty": "MEDIUM",
          "prompt": "CSN có u1 = -1, q = -2. Số hạng u4 là?",
          "options": [
            {
              "id": "a",
              "text": "8"
            },
            {
              "id": "b",
              "text": "-8"
            },
            {
              "id": "c",
              "text": "16"
            }
          ],
          "correctOptionId": "a",
          "explanation": "u4 = u1 * q^3 = (-1) * (-2)^3 = (-1) * (-8) = 8."
        },
        {
          "id": "math-11-cap-so-nhan-q3",
          "difficulty": "APPLIED",
          "prompt": "Tính tổng 5 số hạng đầu của CSN có u1 = 1, q = 2.",
          "options": [
            {
              "id": "a",
              "text": "15"
            },
            {
              "id": "b",
              "text": "31"
            },
            {
              "id": "c",
              "text": "63"
            }
          ],
          "correctOptionId": "b",
          "explanation": "S5 = u1(1-q^5)/(1-q) = 1(1-32)/(1-2) = 31."
        }
      ]
    },
    {
      "id": "math-11-gioi-han-day-so",
      "title": "Giới hạn của dãy số",
      "guidance": [
        "Giới hạn của dãy số đánh giá xu hướng của un khi n tiến tới vô cực.",
        "lim(1/n) = 0. lim(q^n) = 0 nếu |q| < 1."
      ],
      "examples": [
        "lim (2n+1)/(n+2) = lim (2 + 1/n)/(1 + 2/n) = 2/1 = 2."
      ],
      "questions": [
        {
          "id": "math-11-gioi-han-day-so-q1",
          "difficulty": "EASY",
          "prompt": "Giá trị của lim (1/n) bằng?",
          "options": [
            {
              "id": "a",
              "text": "0"
            },
            {
              "id": "b",
              "text": "1"
            },
            {
              "id": "c",
              "text": "+∞"
            }
          ],
          "correctOptionId": "a",
          "explanation": "Khi n tiến tới vô cực, 1 chia cho số vô cùng lớn sẽ tiến tới 0."
        },
        {
          "id": "math-11-gioi-han-day-so-q2",
          "difficulty": "MEDIUM",
          "prompt": "Tính lim (3n^2 - 1)/(n^2 + 2).",
          "options": [
            {
              "id": "a",
              "text": "0"
            },
            {
              "id": "b",
              "text": "3"
            },
            {
              "id": "c",
              "text": "1"
            }
          ],
          "correctOptionId": "b",
          "explanation": "Chia cả tử và mẫu cho n^2, ta được lim (3 - 1/n^2)/(1 + 2/n^2) = 3."
        },
        {
          "id": "math-11-gioi-han-day-so-q3",
          "difficulty": "APPLIED",
          "prompt": "Tính tổng CSN lùi vô hạn: 1 + 1/2 + 1/4 + ...",
          "options": [
            {
              "id": "a",
              "text": "2"
            },
            {
              "id": "b",
              "text": "1.5"
            },
            {
              "id": "c",
              "text": "Vô cực"
            }
          ],
          "correctOptionId": "a",
          "explanation": "S = u1/(1-q) = 1 / (1 - 1/2) = 2."
        }
      ]
    },
    {
      "id": "math-11-gioi-han-ham-so",
      "title": "Giới hạn của hàm số và hàm liên tục",
      "guidance": [
        "Giới hạn hàm số xét sự hội tụ của f(x) khi x dần tới x0.",
        "Hàm f(x) liên tục tại x0 nếu lim(x->x0) f(x) = f(x0)."
      ],
      "examples": [
        "lim(x->2) (x^2 - 4)/(x - 2) = lim (x+2) = 4."
      ],
      "questions": [
