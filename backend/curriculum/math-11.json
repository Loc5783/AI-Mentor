        {
          "id": "math-11-gioi-han-ham-so-q3",
          "difficulty": "APPLIED",
          "prompt": "Hàm số f(x) = (x^2-1)/(x-1) với x≠1 và f(1)=m. Tìm m để hàm liên tục tại x=1.",
          "options": [
            {
