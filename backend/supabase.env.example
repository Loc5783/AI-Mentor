# Copy to backend/.env.supabase.local (ignored by Git). Never put real keys here.
# Administrative questions/quizzes/exams use the shared Supabase catalog.
SUPABASE_URL=https://hnxphwuaccztzanjcuca.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET_KEY
MENTOR_ADMIN_CATALOG=supabase
MENTOR_ADMIN_AUTH_PROVIDER=supabase
# Legacy SUPABASE_SERVICE_ROLE_KEY is accepted if SUPABASE_SECRET_KEY is absent.
# Learner backend login/sessions/progress remain SQLite; Web Admin login uses Supabase.
# No automatic database fallback when Supabase fails. To explicitly use local
# catalog for development only, set MENTOR_ADMIN_CATALOG=sqlite and restart.
