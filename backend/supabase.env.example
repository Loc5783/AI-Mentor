# ==============================================================================
# AI Mentor - Tài liệu Cấu hình Mẫu Tham khảo Supabase (supabase.env.example)
# ==============================================================================
# QUY TẮC BẢO MẬT & ĐỊNH DANH TỆP:
# 1. Tệp này mang tên 'supabase.env.example' để được Git theo dõi (tracked), do mẫu
#    cũ (.env.supabase.example) bị chặn bởi quy tắc **/.env.* trong .gitignore.
# 2. TỆP NÀY CHỈ LÀ TÀI LIỆU THAM KHẢO CHO TƯƠNG LAI (FUTURE REFERENCE ONLY).
#    Runtime hiện tại của FastAPI (Settings.from_env / Database) hoàn toàn KHÔNG
#    đọc hay kích hoạt biến SUPABASE_DATABASE_URL; hệ thống hiện tại 100% dùng SQLite.
# 3. TUYỆT ĐỐI KHÔNG điền mật khẩu thật hay khóa bí mật vào tệp này.
# ==============================================================================

# ------------------------------------------------------------------------------
# HƯỚNG DẪN LẤY CHUỖI KẾT NỐI TỪ SUPABASE DASHBOARD
# ------------------------------------------------------------------------------
# LƯU Ý QUAN TRỌNG TỪ TÀI LIỆU CHÍNH THỨC CỦA SUPABASE:
# Host của Connection Pooler KHÔNG THỂ tự suy đoán hay ghép từ tên vùng (Region).
# Người dùng BẮT BUỘC phải sao chép chính xác Host và Username từ Dashboard Connect:
#   Bước 1: Mở Supabase Dashboard -> Chọn Project -> Bấm nút 'Connect' ở thanh trên.
#   Bước 2: Chọn mục 'Connection Pooling' (Supavisor) -> Chọn chế độ 'Session mode' (Cổng 5432).
#   Bước 3: Sao chép toàn bộ chuỗi URI được Supabase sinh ra.
#
# QUY TẮC MÃ HÓA MẬT KHẨU (PASSWORD PERCENT-ENCODING):
# Nếu mật khẩu cơ sở dữ liệu của bạn chứa các ký tự đặc biệt được chuẩn URI bảo lưu
# (ví dụ: @, :, /, ?, #, [, ], %, !, &, $, ', (, ), *, +, ,, ;, =), bạn BẮT BUỘC
# phải mã hóa URL percent-encoding (RFC 3986) cho mật khẩu trước khi đưa vào URI.
# Ví dụ:
#   - Ký tự '@' phải đổi thành '%40'
#   - Ký tự ':' phải đổi thành '%3A'
#   - Ký tự '#' phải đổi thành '%23'
#   - Ký tự '%' phải đổi thành '%25'
#   - Ký tự '!' phải đổi thành '%21'
# Nếu không mã hóa, trình phân tích URI của PostgreSQL driver sẽ nhận diện sai cú pháp
# và kết nối sẽ thất bại với lỗi xác thực hoặc cú pháp host không hợp lệ.
#
# PLACEHOLDER MẪU HOÀN TOÀN KHÔNG HOẠT ĐỘNG (NON-FUNCTIONAL PLACEHOLDER):
# (Chỉ dùng để tham khảo cấu trúc khi nhóm phát triển thực hiện adapter Postgres sau này)
SUPABASE_DATABASE_URL=postgresql://[USER-FROM-DASHBOARD]:[PASSWORD-PERCENT-ENCODED]@[HOST-FROM-DASHBOARD]:5432/[DB-NAME]?sslmode=require

# Cấu hình kích thước pool kết nối dự kiến cho tương lai:
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# DỮ LIỆU TỆP ĐÍNH KÈM (UPLOADS) ĐỘC LẬP VỚI CƠ SỞ DỮ LIỆU
# ------------------------------------------------------------------------------
# CSDL Postgres chỉ chứa siêu dữ liệu (metadata trong bảng resources).
# File nhị phân (.bin) người dùng tải lên được lưu cục bộ trên ổ cứng máy chủ.
MENTOR_DATA_DIR=data

# ------------------------------------------------------------------------------
# CẤU HÌNH AI PROVIDER & DEMO (GIỮ NGUYÊN)
# ------------------------------------------------------------------------------
AI_PROVIDER_TYPE=unconfigured
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
MENTOR_DEMO_MODE=0
