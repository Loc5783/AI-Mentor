<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="true" android:focusableInTouchMode="true" android:orientation="vertical" android:padding="16dp" android:background="@color/mentor_quiz_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/mentor_history_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/mentor_ic_back" android:tint="@color/mentor_quiz_text" android:contentDescription="@string/mentor_quiz_back" android:visibility="gone" />
        <TextView android:id="@+id/mentor_history_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/mentor_history_title" android:textColor="@color/mentor_quiz_text" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <Button android:id="@+id/mentor_history_new" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/mentor_history_new_chat" android:textAllCaps="false" />
        <ImageButton android:id="@+id/mentor_history_delete_all" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/mentor_ic_more_vertical" android:tint="@color/mentor_quiz_secondary" android:contentDescription="@string/mentor_history_options" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <EditText android:id="@+id/mentor_history_search" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/mentor_history_search" android:textColor="@color/mentor_quiz_text" android:textColorHint="@color/mentor_quiz_secondary" android:inputType="text" android:maxLines="1" android:imeOptions="actionSearch" />
        <Button android:id="@+id/mentor_history_clear" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/mentor_history_clear_glyph" android:textSize="20sp" android:contentDescription="@string/mentor_history_clear" />
    </LinearLayout>
    <Spinner android:id="@+id/mentor_history_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:contentDescription="@string/mentor_history_period" />
    <TextView android:id="@+id/mentor_history_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="24dp" android:paddingBottom="24dp" android:text="@string/mentor_history_empty" android:textColor="@color/mentor_quiz_secondary" android:textSize="15sp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/mentor_history_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp" />
</LinearLayout>
