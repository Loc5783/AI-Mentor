<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/history_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <androidx.cardview.widget.CardView android:id="@+id/card_ai_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardCornerRadius="20dp" app:cardElevation="1dp" android:stateListAnimator="@animator/mentor_card_press">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/history_banner_blue_bg" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/history_solver_intro_title" android:textColor="@color/history_banner_blue_text" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/history_solver_intro_desc" android:textColor="@color/history_banner_blue_subtext" android:textSize="13sp" />
                </LinearLayout>
                <ImageView android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="@string/history_chat_title" android:src="@drawable/mentor_ic_info" app:tint="@color/history_banner_blue_text" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <com.example.mentor.ui.AdaptiveCardRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
            <androidx.cardview.widget.CardView android:id="@+id/btn_camera_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardCornerRadius="20dp" app:cardElevation="1dp" android:stateListAnimator="@animator/mentor_card_press">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="16dp" android:background="@color/history_surface">
                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:contentDescription="@string/history_solver_btn_camera" android:src="@drawable/mentor_ic_camera" app:tint="@color/history_accent_blue" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/history_solver_btn_camera" android:textColor="@color/history_text_primary" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/btn_input_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardCornerRadius="20dp" app:cardElevation="1dp" android:stateListAnimator="@animator/mentor_card_press">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="16dp" android:background="@color/history_surface">
                    <ImageView android:layout_width="38dp" android:layout_height="38dp" android:contentDescription="@string/history_solver_btn_input" android:src="@drawable/mentor_ic_pen" app:tint="@color/history_accent_blue" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/history_solver_btn_input" android:textColor="@color/history_text_primary" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </com.example.mentor.ui.AdaptiveCardRow>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/history_home_choose" android:textColor="@color/history_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <com.example.mentor.ui.AdaptiveCardRow android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/history_topic_vietnam" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/history_home_vietnam" android:textAllCaps="false" android:layout_marginEnd="6dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/history_topic_world" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/history_home_world" android:textAllCaps="false" android:layout_marginStart="6dp" />
        </com.example.mentor.ui.AdaptiveCardRow>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_home_draft_hint" android:textSize="13sp" android:textColor="@color/history_text_secondary" />
        <LinearLayout android:id="@+id/history_progress_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/history_progress_background" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="@string/history_home_progress_action">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_home_progress_action" android:textColor="@color/history_text_primary" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:id="@+id/history_home_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/history_text_secondary" />
            <ProgressBar android:id="@+id/history_home_progress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="100" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/history_open_notes" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/history_home_notes" android:textAllCaps="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/history_solver_recent_title" android:textColor="@color/history_title" android:textSize="16sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/history_view_all" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/history_home_view_all" android:textAllCaps="false" />
        <TextView android:id="@+id/tvRecentEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/history_solver_recent_empty" android:textColor="@color/history_text_hint" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_recent_solver" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>