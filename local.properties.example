# Copy this file to local.properties only when Android Studio does not create it.
# Use the Android SDK path installed on your own computer.
# Windows example (escape backslashes):
# sdk.dir=C\:\\Users\\YOUR_NAME\\AppData\\Local\\Android\\Sdk
# macOS example:
# sdk.dir=/Users/YOUR_NAME/Library/Android/sdk
# Linux example:
# sdk.dir=/home/YOUR_NAME/Android/Sdk

