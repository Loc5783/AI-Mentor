<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/math_chat_bg"> <!-- Màu nền xám xanh nhẹ cho dịu mắt -->

    <!-- Khu vực cuộn hiển thị tin nhắn -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/math_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_input"
        android:padding="8dp"
        android:clipToPadding="false"/> <!-- Đã xóa android:fitsSystemWindows="true" ở đây -->

    <!-- Khu vực nhập liệu (Dưới cùng) -->
    <LinearLayout
        android:id="@+id/layout_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/math_chat_input_bg"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- Nút chọn ảnh chụp đề toán -->
        <ImageButton
            android:id="@+id/math_btn_upload_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="@string/math_chat_upload"
            app:tint="@color/math_primary" />

        <!-- Ô nhập câu hỏi bằng chữ -->
        <EditText
            android:id="@+id/math_edt_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/math_chat_hint"
            android:textColor="@color/math_chat_text"
            android:textColorHint="@color/math_inactive"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:maxLines="4"
            android:inputType="textMultiLine"/>

        <!-- Nút Gửi cho AI -->
        <ImageButton
            android:id="@+id/math_btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="@string/math_chat_send"
            app:tint="@color/math_primary" />
    </LinearLayout>
</RelativeLayout>