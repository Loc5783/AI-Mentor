<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/math_background">

    <!-- Thanh Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar_formula"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp">
        <ImageButton
            android:id="@+id/btn_math_module_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/math_back_description"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/math_formula_accent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/math_nav_notes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/math_formula_accent" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_formula"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner Cam -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/math_formula_banner">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:id="@+id/txt_banner_formula"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:text="@string/math_formula_banner_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/math_formula_accent" />
                    <TextView
                        android:layout_width="180dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txt_banner_formula"
                        android:layout_marginTop="8dp"
                        android:text="@string/math_formula_banner_desc"
                        android:textSize="13sp"
                        android:textColor="@color/math_formula_primary" />
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/mathematicalformula"
                        app:tint="@color/math_formula_icon"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bộ lọc chủ đề (Scroll ngang) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btn_filter_all_note"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/math_history_filter_all"
                        android:backgroundTint="@color/math_formula_icon"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        app:cornerRadius="20dp"/>
                    <Button
                        android:id="@+id/btn_filter_algebra"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="@string/math_formula_filter_algebra"
                        android:backgroundTint="@color/math_button_inactive_bg"
                        android:textColor="@color/math_button_inactive_text"
                        android:textAllCaps="false"
                        app:cornerRadius="20dp"/>

                    <Button
                        android:id="@+id/btn_filter_geometry"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/math_button_inactive_bg"
                        android:text="@string/math_formula_filter_geometry"
                        android:textAllCaps="false"
                        android:textColor="@color/math_button_inactive_text"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Khung Item Công Thức (Dùng text thường mô phỏng) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

            </androidx.cardview.widget.CardView>


            <TextView
                android:id="@+id/txt_empty_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/math_formula_empty"
                android:textColor="@color/math_inactive"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_notes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingBottom="100dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Nút Thêm công thức (Nổi ở góc dưới) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_add_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/math_formula_icon"
        app:tint="#FFFFFF"
        android:elevation="6dp"/>
</RelativeLayout>