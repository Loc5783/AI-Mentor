<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/math_background">


    <RelativeLayout android:id="@+id/toolbar_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:minHeight="64dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/btn_math_module_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/math_back_description" android:padding="8dp" android:src="@drawable/mentor_ic_back" app:tint="@color/math_history_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="@string/math_nav_history" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/math_history_primary" android:layout_marginStart="56dp" android:layout_marginEnd="56dp" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
    </RelativeLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/toolbar_history" android:scrollbars="none">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">


            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/math_history_banner">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
                    <TextView android:id="@+id/txt_banner_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/math_history_banner_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/math_history_accent" android:layout_toStartOf="@id/math_banner_illustration" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/txt_banner_history" android:layout_marginTop="8dp" android:text="@string/math_history_banner_desc" android:textSize="13sp" android:textColor="@color/math_history_primary" android:layout_toStartOf="@id/math_banner_illustration" android:layout_marginEnd="12dp" />
                    <ImageView android:layout_width="56dp" android:layout_height="56dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/calender" app:tint="@color/math_history_icon" android:id="@+id/math_banner_illustration" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>


            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                    <Button android:id="@+id/btn_filter_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/math_history_filter_all" android:backgroundTint="@color/math_history_icon" android:textColor="@color/math_active_text" android:textAllCaps="false" app:cornerRadius="20dp" android:minHeight="48dp" />

                    <Button android:id="@+id/btn_filter_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/math_history_filter_today" android:backgroundTint="@color/math_button_inactive_bg" android:textColor="@color/math_button_inactive_text" android:textAllCaps="false" app:cornerRadius="20dp" android:minHeight="48dp" />

                    <Button android:id="@+id/btn_filter_7days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/math_history_filter_7days" android:backgroundTint="@color/math_button_inactive_bg" android:textColor="@color/math_button_inactive_text" android:textAllCaps="false" app:cornerRadius="20dp" android:minHeight="48dp" />

                </LinearLayout>
            </HorizontalScrollView>


            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="@string/math_history_section_title" android:textStyle="bold" android:textColor="@color/math_text_primary" />

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />

            <View android:layout_width="match_parent" android:layout_height="80dp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
