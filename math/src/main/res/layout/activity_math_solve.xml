<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/math_background">

    <!-- Thanh Toolbar trên cùng -->
    <RelativeLayout
        android:id="@+id/toolbar_solve"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp">
        <ImageButton
            android:id="@+id/btn_math_module_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/math_back_description"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/math_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/math_solve_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/math_primary" />
    </RelativeLayout>

    <!-- Đã sửa lỗi đóng thẻ ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar_solve"
        android:layout_above="@+id/bottom_nav_placeholder"
        android:scrollbars="none">

        <!-- Đã sửa lỗi đóng thẻ LinearLayout bao bọc nội dung -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner Xanh dương -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/math_banner_bg">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:id="@+id/txt_banner_title"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:text="@string/math_banner_title"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/math_banner_title" />
                    <TextView
                        android:layout_width="180dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txt_banner_title"
                        android:layout_marginTop="8dp"
                        android:text="@string/math_banner_desc"
                        android:textSize="13sp"
                        android:textColor="@color/math_banner_desc" />
                    <ImageView
                        android:id="@+id/img_banner_ai"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ai"
                        app:tint="@color/math_banner_title" /> <!-- Icon Robot -->
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2 Nút chức năng chính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <!-- Nút Chụp đề bài -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_scan_math"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:background="@color/math_surface">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/camera"
                            app:tint="@color/math_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/math_action_scan"
                            android:textStyle="bold"
                            android:textColor="@color/math_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/math_action_scan_desc"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/math_text_secondary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Nút Nhập đề bài -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_type_math"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:background="@color/math_surface">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/pen"
                            app:tint="@color/math_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/math_action_type"
                            android:textStyle="bold"
                            android:textColor="@color/math_primary" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/math_action_type_desc"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/math_text_secondary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Placeholder Thanh Bottom Nav -->
    <View
        android:id="@+id/bottom_nav_placeholder"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@color/math_surface"
        android:elevation="8dp"/>
</RelativeLayout>