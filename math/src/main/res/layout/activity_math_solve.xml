<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/math_background">
    <RelativeLayout android:id="@+id/toolbar_solve" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:minHeight="64dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/btn_math_module_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_centerVertical="true" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/math_back_description" android:padding="8dp" android:src="@drawable/mentor_ic_back" app:tint="@color/math_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="@string/math_solve_title" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/math_primary" android:layout_marginStart="56dp" android:layout_marginEnd="56dp" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
    </RelativeLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/toolbar_solve" android:layout_above="@+id/bottom_nav_placeholder" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/math_banner_bg">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp">
                    <TextView android:id="@+id/txt_banner_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/math_banner_title" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/math_banner_title" android:layout_toStartOf="@id/img_banner_ai" android:layout_marginEnd="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/txt_banner_title" android:layout_marginTop="8dp" android:text="@string/math_banner_desc" android:textSize="13sp" android:textColor="@color/math_banner_desc" android:layout_toStartOf="@id/img_banner_ai" android:layout_marginEnd="12dp" />
                    <ImageView android:id="@+id/img_banner_ai" android:layout_width="40dp" android:layout_height="40dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ai" app:tint="@color/math_banner_title" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <com.example.mentor.ui.AdaptiveCardRow android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:weightSum="2">
                <androidx.cardview.widget.CardView android:id="@+id/btn_scan_math" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" app:cardCornerRadius="20dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@color/math_surface" android:minHeight="76dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/camera" app:tint="@color/math_primary" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/math_action_scan" android:textStyle="bold" android:textColor="@color/math_primary" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/math_action_scan_desc" android:textSize="12sp" android:gravity="start" android:layout_marginTop="4dp" android:textColor="@color/math_text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView android:id="@+id/btn_type_math" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" app:cardCornerRadius="20dp" app:cardElevation="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@color/math_surface" android:minHeight="76dp">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/pen" app:tint="@color/math_primary" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/math_action_type" android:textStyle="bold" android:textColor="@color/math_primary" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/math_action_type_desc" android:textSize="12sp" android:gravity="start" android:layout_marginTop="4dp" android:textColor="@color/math_text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </com.example.mentor.ui.AdaptiveCardRow>
            <com.google.android.material.button.MaterialButton android:id="@+id/button_math_calculator" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp" android:text="@string/math_calculator_title" />
        </LinearLayout>
    </ScrollView>
    <View android:id="@+id/bottom_nav_placeholder" android:layout_width="match_parent" android:layout_height="0dp" android:layout_alignParentBottom="true" android:background="@color/math_surface" android:elevation="8dp" />
</RelativeLayout>