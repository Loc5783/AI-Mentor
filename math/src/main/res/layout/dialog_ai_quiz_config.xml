<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/math_quiz_config_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/math_quiz_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/math_quiz_config_topic"
        android:textStyle="bold"
        android:textColor="@color/math_quiz_text" />

    <EditText
        android:id="@+id/edt_quiz_topic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/math_quiz_config_topic_hint"
        android:textColor="@color/math_text_primary"
        android:textColorHint="@color/math_inactive"
        android:inputType="text"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/math_quiz_config_level"
        android:textStyle="bold"
        android:textColor="@color/math_quiz_text" />

    <Spinner
        android:id="@+id/spinner_education_level"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:entries="@array/math_education_levels"
        android:contentDescription="@string/math_quiz_config_level" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/math_quiz_config_count"
        android:textStyle="bold"
        android:textColor="@color/math_quiz_text" />

    <Spinner
        android:id="@+id/spinner_question_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:entries="@array/quiz_counts" />

    <Button
        android:id="@+id/btn_generate_ai_quiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/math_quiz_config_btn"
        android:textAllCaps="false"
        android:backgroundTint="@color/math_quiz_primary"
        android:textColor="@color/math_active_text" />

</LinearLayout>
