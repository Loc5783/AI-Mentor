<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true">

    <!-- Toolbar Modal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/bg_header_custom">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/note_cancel"
            android:textSize="17sp"
            android:textColor="@color/text_header_light"
            android:alpha="0.7"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/note_new_title"
            android:textSize="17sp"
            android:textColor="@color/text_header_light"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/note_save"
            android:textSize="17sp"
            android:textColor="@color/gold"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Input Tiêu đề -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/note_hint_title"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="20sp"
        android:fontFamily="sans-serif"
        android:background="@null"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:maxLines="1"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/surface_light"/>

    <!-- Input Nội dung -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_note_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="@string/note_hint_content"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="17sp"
        android:fontFamily="sans-serif"
        android:background="@null"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:gravity="top"/>

</LinearLayout>