<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/bg_secondary" android:layout_marginBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

            <TextView android:id="@+id/tv_chat_question" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_history_hint_q" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />

            <TextView android:id="@+id/tv_chat_answer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_history_hint_a" android:textSize="14sp" android:textColor="@color/text_secondary" android:fontFamily="sans-serif" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" />

            <TextView android:id="@+id/tv_chat_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="10:30" android:textSize="12sp" android:textColor="@color/text_tertiary" android:fontFamily="sans-serif" android:layout_marginTop="6dp" />
        </LinearLayout>

        <ImageView android:id="@+id/iv_delete_session" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_delete" app:tint="#FF6B6B" android:padding="6dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:layout_marginStart="8dp" android:alpha="0.7" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
