<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">


    <LinearLayout android:id="@+id/ll_user_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:visibility="gone">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:maxWidth="280dp">


            <TextView android:id="@+id/tv_user_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="14dp" android:background="@drawable/bg_chat_bubble_user_dark" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif" android:visibility="gone" android:layout_marginBottom="8dp" />


            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">

                <TextView android:id="@+id/tv_image_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_tertiary" android:fontFamily="sans-serif" android:layout_marginBottom="4dp" android:layout_marginEnd="4dp" android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_user_images" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxHeight="120dp" android:minHeight="0dp" android:orientation="horizontal" android:visibility="gone" android:clipToPadding="false" android:paddingStart="4dp" android:paddingEnd="4dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <TextView android:id="@+id/tv_user_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_tertiary" android:fontFamily="sans-serif" android:layout_marginTop="4dp" android:layout_marginEnd="8dp" android:visibility="gone" />
        </LinearLayout>

        <ImageView android:id="@+id/iv_user_avatar" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_profile" android:padding="4dp" android:layout_marginStart="8dp" android:background="@drawable/bg_icon_circle_dark" />
    </LinearLayout>


    <LinearLayout android:id="@+id/ll_ai_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="start" android:visibility="gone">

        <ImageView android:id="@+id/iv_ai_avatar" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_ai_avatar" android:padding="4dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_icon_circle_dark" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="start" android:maxWidth="280dp">

            <androidx.cardview.widget.CardView android:layout_width="wrap_content" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/bg_secondary">

                <TextView android:id="@+id/tv_ai_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="14dp" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="sans-serif" android:lineSpacingExtra="4dp" />
            </androidx.cardview.widget.CardView>

            <TextView android:id="@+id/tv_ai_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_tertiary" android:fontFamily="sans-serif" android:layout_marginTop="4dp" android:layout_marginStart="8dp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
