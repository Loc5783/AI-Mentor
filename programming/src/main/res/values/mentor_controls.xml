<resources>
<color name="mentor_programming_button">#6537C5</color>
    <style name="MentorProgrammingButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/mentor_programming_button</item><item name="android:textColor">#FFFFFF</item><item name="cornerRadius">@dimen/mentor_control_radius</item><item name="rippleColor">@color/mentor_control_ripple</item><item name="android:minHeight">@dimen/mentor_control_height</item>
        <item name="android:textAllCaps">false</item><item name="android:textSize">@dimen/mentor_control_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="MentorProgrammingInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/mentor_control_radius</item><item name="boxCornerRadiusTopEnd">@dimen/mentor_control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/mentor_control_radius</item><item name="boxCornerRadiusBottomEnd">@dimen/mentor_control_radius</item>
    </style>
<style name="MentorProgrammingNavLabel"><item name="android:textSize">@dimen/mentor_nav_text</item><item name="android:fontFamily">sans-serif-medium</item></style></resources>