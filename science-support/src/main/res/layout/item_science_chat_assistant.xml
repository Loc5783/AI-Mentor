<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/science_chat_avatar_background"
        android:gravity="center"
        android:text="AI"
        android:textColor="@color/science_on_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/science_panel"
        android:orientation="vertical"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/progressChatMessage"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvChatAssistantMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/science_text_primary"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvChatCacheNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/science_chat_cache_badge"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="@color/science_primary_dark"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutChatActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopyChatAnswer"
                style="@style/ChatMessageActionButton"
                android:text="Sao chép" />

            <Button
                android:id="@+id/btnBookmarkChatAnswer"
                style="@style/ChatMessageActionButton"
                android:text="Lưu" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
