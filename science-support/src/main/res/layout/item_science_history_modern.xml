<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="88dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="8dp">
    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/science_icon_bg_green" android:padding="11dp"><ImageView android:id="@+id/imageHistorySubject" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:src="@drawable/ic_science_chemistry" app:tint="@color/science_history_color" /></FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/textHistoryTitle" style="@style/ScienceListTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" /><TextView android:id="@+id/textHistoryPreview" style="@style/ScienceListSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" /></LinearLayout>
    <TextView android:id="@+id/textHistoryTime" style="@style/ScienceListSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_science_arrow_right" app:tint="@color/science_nav_unselected" />
</LinearLayout>
