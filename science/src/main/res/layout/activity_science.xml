<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background">

    <com.brightpath.science.presentation.view.ScienceAnimatedBackgroundView android:id="@+id/scienceAnimatedBackground" android:layout_width="0dp" android:layout_height="0dp" android:alpha="0.14" android:importantForAccessibility="no" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout android:id="@+id/layoutScienceHeader" android:layout_width="0dp" android:layout_height="64dp" android:background="@color/science_bg_header_custom" android:elevation="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

        <Button android:id="@+id/btnScienceBack" style="@style/ScienceSquareIconButton" android:contentDescription="@string/science_back" android:text="‹" android:textColor="@color/science_text_primary" android:textSize="28sp" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/science_solve_title" android:textColor="@color/science_text_header_light" android:textSize="20sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvChatSubjectStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="" android:textColor="@color/science_text_header_light" android:alpha="0.8" android:textSize="14sp" />
        </LinearLayout>

        <Button android:id="@+id/btnNewScienceChat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="@color/science_icon_blue_background" android:minWidth="64dp" android:text="@string/science_chat_new" android:textAllCaps="false" android:textColor="@color/science_solve_color" android:textSize="14sp" android:textStyle="bold" android:minHeight="48dp" />

        <Button android:id="@+id/btnChatTools" style="@style/ScienceSquareIconButton" android:layout_marginStart="6dp" android:contentDescription="@string/science_quick_tools" android:text="⋮" android:textColor="@color/science_text_primary" android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/panelChatTools" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/science_surface" android:elevation="2dp" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layoutScienceHeader">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chọn môn, trình độ và cách giải thích phù hợp với bài đang học." android:textColor="@color/science_text_secondary" android:textSize="14sp" />

        <RadioGroup android:id="@+id/rgScienceSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">

            <RadioButton android:id="@+id/rbPhysics" style="@style/ScienceSubjectRadio" android:checked="true" android:text="Vật lý" />

            <RadioButton android:id="@+id/rbChemistry" style="@style/ScienceSubjectRadio" android:text="Hóa học" />

            <RadioButton android:id="@+id/rbBiology" style="@style/ScienceSubjectRadio" android:text="Sinh học" />
        </RadioGroup>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/science_quiz_edu_level_label" android:textColor="@color/science_text_secondary" android:textSize="14sp" />

                <Spinner android:id="@+id/spEducationLevel" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_quiz_edu_level_label" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/science_chat_explanation_title" android:textColor="@color/science_text_secondary" android:textSize="14sp" />

                <Spinner android:id="@+id/spExplanationStyle" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_chat_explanation_title" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                <Button android:id="@+id/btnScienceHistory" style="@style/ChatToolButton" android:text="@string/science_tool_history" />
                <Button android:id="@+id/btnScienceBookmarks" style="@style/ChatToolButton" android:text="@string/science_tool_bookmarks" />
                <Button android:id="@+id/btnScienceQuiz" style="@style/ChatToolButton" android:text="@string/science_tool_quiz" />
                <Button android:id="@+id/btnSciencePlanner" style="@style/ChatToolButton" android:text="@string/science_tool_planner" />
                <Button android:id="@+id/btnPeriodicTable" style="@style/ChatToolButton" android:text="@string/science_tool_periodic" />
                <Button android:id="@+id/btnCircuitDiagram" style="@style/ChatToolButton" android:text="@string/science_tool_circuit" />
                <Button android:id="@+id/btnScienceProgress" style="@style/ChatToolButton" android:text="@string/science_tool_progress" />
                <Button android:id="@+id/btnScienceDisplaySettings" style="@style/ChatToolButton" android:text="@string/science_tool_settings" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout android:id="@+id/layoutChatContent" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toTopOf="@id/layoutChatComposer" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/panelChatTools">

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvScienceChat" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="12dp" android:paddingTop="18dp" android:paddingEnd="12dp" android:paddingBottom="22dp" android:scrollbars="vertical" />

        <com.google.android.material.card.MaterialCardView android:id="@+id/layoutModelInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="8dp" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:strokeColor="@color/science_border" app:strokeWidth="1dp">

            <TextView android:id="@+id/tvModelInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:text="AI đang sẵn sàng" android:textColor="@color/science_text_secondary" android:textSize="15sp" android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:id="@+id/layoutChatEmptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="36dp" android:paddingEnd="24dp" android:paddingBottom="24dp">

            <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/science_icon_bg_blue" android:padding="18dp">

                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_ai_mentor" android:src="@drawable/ic_science_chat" app:tint="@color/science_solve_color" />
            </FrameLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/science_chat_welcome_title" android:textColor="@color/science_text_primary" android:textSize="21sp" android:textStyle="bold" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="@string/science_chat_welcome_desc" android:textColor="@color/science_text_secondary" android:textSize="15sp" />

            <Button android:id="@+id/btnSuggestionPhenomenon" style="@style/ChatSuggestionButton" android:layout_marginTop="18dp" android:text="@string/science_suggestion_step_by_step" />

            <Button android:id="@+id/btnSuggestionChemistry" style="@style/ChatSuggestionButton" android:text="@string/science_suggestion_equations" />

            <Button android:id="@+id/btnSuggestionBiology" style="@style/ChatSuggestionButton" android:text="@string/science_suggestion_phenomenon" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:id="@+id/layoutChatComposer" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/science_surface" android:elevation="8dp" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">

        <FrameLayout android:id="@+id/layoutSelectedImage" android:layout_width="104dp" android:layout_height="104dp" android:layout_marginStart="8dp" android:layout_marginBottom="8dp" android:background="@drawable/science_chat_image_preview_background" android:padding="4dp" android:visibility="gone">

            <ImageView android:id="@+id/ivSciencePreview" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Ảnh câu hỏi đã chọn" android:scaleType="centerCrop" />

            <Button android:id="@+id/btnClearImage" android:layout_width="48dp" android:layout_height="wrap_content" android:layout_gravity="top|end" android:background="@drawable/science_chat_remove_image_background" android:contentDescription="Xóa ảnh" android:minWidth="40dp" android:minHeight="48dp" android:padding="0dp" android:text="×" android:textColor="@color/science_white" android:textSize="20sp" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/science_surface_variant" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:strokeColor="@color/science_border" app:strokeWidth="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal" android:padding="5dp">

                <Button android:id="@+id/btnPickImage" android:layout_width="48dp" android:layout_height="wrap_content" android:backgroundTint="@android:color/transparent" android:contentDescription="Chọn ảnh bài tập" android:minWidth="46dp" android:minHeight="48dp" android:padding="0dp" android:text="＋" android:textColor="@color/science_solve_color" android:textSize="23sp" />

                <Button android:id="@+id/btnTakePhoto" android:layout_width="48dp" android:layout_height="wrap_content" android:backgroundTint="@android:color/transparent" android:contentDescription="Chụp ảnh bài tập" android:minWidth="46dp" android:minHeight="48dp" android:padding="0dp" android:text="⌾" android:textColor="@color/science_solve_color" android:textSize="22sp" />

                <EditText android:id="@+id/etScienceQuestion" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@android:color/transparent" android:gravity="top|start" android:hint="Nhập đề bài, dữ kiện hoặc điều chưa hiểu..." android:imeOptions="actionSend" android:inputType="textCapSentences|textMultiLine" android:maxLines="6" android:minHeight="48dp" android:paddingStart="8dp" android:paddingTop="12dp" android:paddingEnd="8dp" android:paddingBottom="10dp" android:textColor="@color/science_text_primary" android:textColorHint="@color/science_text_secondary" android:textSize="15sp" />

                <Button android:id="@+id/btnAskScience" android:layout_width="48dp" android:layout_height="wrap_content" android:background="@drawable/science_chat_send_background" android:contentDescription="Gửi câu hỏi" android:minWidth="48dp" android:minHeight="48dp" android:padding="0dp" android:text="↑" android:textColor="@color/science_on_primary" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="5dp" android:text="@string/science_chat_disclaimer" android:textColor="@color/science_text_secondary" android:textSize="15sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
