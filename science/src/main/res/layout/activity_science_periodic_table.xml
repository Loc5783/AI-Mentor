<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background" android:orientation="vertical" android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/science_bg_header_custom" android:padding="12dp">

        <Button android:id="@+id/btnPeriodicBack" style="@style/ScienceSquareIconButton" android:contentDescription="@string/science_back" android:text="‹" android:textColor="@color/science_text_primary" android:textSize="28sp" />

        <TextView style="@style/ScienceHeaderTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/science_periodic_table" android:textColor="@color/science_text_header_light" />
    </LinearLayout>

    <EditText android:id="@+id/etElementSearch" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/science_field_background" android:hint="@string/science_periodic_search_hint" android:inputType="text" android:paddingHorizontal="14dp" android:textColor="@color/science_text_primary" android:textColorHint="@color/science_text_secondary" />

    <Button android:id="@+id/btnElementSearch" style="@style/SciencePrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/science_periodic_btn_search" android:minHeight="52dp" />

    <TextView android:id="@+id/tvElementCount" style="@style/ScienceSecondaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvPeriodicTable" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp" />
</LinearLayout>
