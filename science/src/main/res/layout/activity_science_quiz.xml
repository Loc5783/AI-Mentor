<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/science_bg_header_custom" android:padding="12dp">

            <Button android:id="@+id/btnQuizBack" style="@style/ScienceSquareIconButton" android:contentDescription="@string/science_back" android:text="‹" android:textColor="@color/science_text_primary" android:textSize="28sp" />

            <TextView style="@style/ScienceHeaderTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/science_quiz_adaptive_title" android:textColor="@color/science_text_header_light" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/science_hero_purple" android:orientation="vertical" android:padding="16dp">

            <TextView android:id="@+id/tvScienceLevelTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/science_level_1" android:textColor="@color/science_quiz_color" android:textSize="20sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvScienceTotalExp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/science_total_exp_format" android:textColor="@color/science_text_secondary" android:textSize="14sp" />

            <ProgressBar android:id="@+id/progressScienceLevel" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressBackgroundTint="@color/science_progress_track" android:progressTint="@color/science_quiz_color" />

            <TextView android:id="@+id/tvScienceLevelProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="" android:textColor="@color/science_text_secondary" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/science_quiz_rewards" android:textColor="@color/science_text_secondary" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/science_panel" android:orientation="vertical" android:padding="14dp">

            <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/science_quiz_subject_label" />

            <Spinner android:id="@+id/spQuizSubject" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_quiz_subject_label" />

            <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/science_quiz_edu_level_label" />

            <Spinner android:id="@+id/spQuizLevel" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_quiz_edu_level_label" />

            <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/science_quiz_topic_label" />

            <EditText android:id="@+id/etQuizTopic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/science_field_background" android:hint="@string/science_quiz_topic_hint" android:inputType="textCapSentences" android:minHeight="52dp" android:textColor="@color/science_text_primary" android:textColorHint="@color/science_text_secondary" />

            <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/science_quiz_count_label" />

            <Spinner android:id="@+id/spQuizCount" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_quiz_count_label" />

            <TextView android:id="@+id/tvQuizAdaptiveStatus" style="@style/ScienceSecondaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/science_panel" android:padding="12dp" android:text="@string/science_quiz_adaptive_desc" android:accessibilityLiveRegion="polite" />

            <Button android:id="@+id/btnGenerateQuiz" style="@style/SciencePrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/science_quiz_btn_new" android:minHeight="52dp" />

            <ProgressBar android:id="@+id/progressQuiz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:id="@+id/quizContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />

        <Button android:id="@+id/btnSubmitQuiz" style="@style/SciencePrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/science_quiz_btn_submit" android:visibility="gone" android:minHeight="52dp" />

        <TextView android:id="@+id/tvQuizResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/science_panel" android:gravity="center" android:padding="14dp" android:textColor="@color/science_text_primary" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" android:accessibilityLiveRegion="assertive" />
    </LinearLayout>
</ScrollView>
