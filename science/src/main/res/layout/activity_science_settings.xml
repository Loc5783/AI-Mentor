<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

            <Button android:id="@+id/btnScienceSettingsBack" style="@style/ScienceSquareIconButton" android:contentDescription="@string/science_back" android:text="‹" android:textSize="28sp" />

            <TextView style="@style/ScienceHeaderTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/science_tool_science_settings" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/science_panel" android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/ScienceHeaderTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/science_tool_ai_provider" android:textSize="18sp" />

            <TextView android:id="@+id/tvScienceProviderStatus" style="@style/ScienceSecondaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/science_option_background" android:minHeight="52dp" android:padding="12dp" android:text="@string/science_tool_gemini_configuration_is_managed_by_the_host" />

            <TextView style="@style/ScienceSecondaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/science_tool_the_api_key_is_not_shown_or" />

            <Button android:id="@+id/btnTestGeminiConnection" style="@style/ScienceSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/science_tool_test_gemini_connection" android:minHeight="52dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/science_panel" android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/ScienceHeaderTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/science_tool_display_and_accessibility" android:textSize="18sp" />

            <CheckBox android:id="@+id/cbScienceAnimation" android:layout_width="match_parent" android:layout_height="wrap_content" android:buttonTint="@color/science_control_tint" android:minHeight="52dp" android:text="@string/science_tool_use_subtle_animated_background" android:textColor="@color/science_text_primary" />

            <TextView style="@style/ScienceSecondaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/science_tool_animation_pauses_automatically_in_battery_saver_text" />

            <Button android:id="@+id/btnSaveScienceDisplaySettings" style="@style/SciencePrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/science_tool_save_display_settings" android:minHeight="52dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
