<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/science_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScienceSettingsBack"
                style="@style/ScienceSquareIconButton"
                android:contentDescription="Back"
                android:text="‹"
                android:textSize="28sp" />

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Science settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/science_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI provider"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvScienceProviderStatus"
                style="@style/ScienceSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/science_option_background"
                android:minHeight="52dp"
                android:padding="12dp"
                android:text="Gemini configuration is managed by the host project." />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="The API key is not shown or editable inside the application." />

            <Button
                android:id="@+id/btnTestGeminiConnection"
                style="@style/ScienceSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Test Gemini connection" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/science_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display and accessibility"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/cbScienceAnimation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/science_control_tint"
                android:minHeight="52dp"
                android:text="Use subtle animated background"
                android:textColor="@color/science_text_primary" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Animation pauses automatically in battery saver. Text and selectable controls use high-contrast states and large touch targets." />

            <Button
                android:id="@+id/btnSaveScienceDisplaySettings"
                style="@style/SciencePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Save display settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
