<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/science_bg_header_custom" android:padding="12dp">

            <Button android:id="@+id/btnStudyPlannerBack" style="@style/ScienceSquareIconButton" android:contentDescription="@string/science_back" android:text="‹" android:textColor="@color/science_text_primary" android:textSize="28sp" />

            <TextView style="@style/ScienceHeaderTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/science_planner_title" android:textColor="@color/science_text_header_light" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/science_panel" android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/ScienceSecondaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/science_planner_info" />

            <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/science_planner_subject" />

            <Spinner android:id="@+id/spPlannerSubject" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_planner_subject" />

            <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/science_planner_edu_level" />

            <Spinner android:id="@+id/spPlannerLevel" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_planner_edu_level" />

            <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/science_planner_goal" />

            <EditText android:id="@+id/etPlannerGoal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/science_field_background" android:hint="@string/science_planner_goal_hint" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:minHeight="64dp" android:textColor="@color/science_text_primary" android:textColorHint="@color/science_text_secondary" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                    <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/science_planner_length" />

                    <Spinner android:id="@+id/spPlannerDays" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_planner_length" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">

                    <TextView style="@style/ScienceSecondaryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/science_planner_daily_time" />

                    <Spinner android:id="@+id/spPlannerMinutes" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/science_planner_daily_time" />
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btnGenerateStudyPlan" style="@style/SciencePrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/science_planner_btn_generate" android:minHeight="52dp" />

            <ProgressBar android:id="@+id/progressStudyPlan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/tvStudyPlanStatus" style="@style/ScienceSecondaryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/science_panel" android:padding="14dp" android:text="@string/science_planner_empty" android:accessibilityLiveRegion="polite" />

        <LinearLayout android:id="@+id/layoutStudySessions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />

        <Button android:id="@+id/btnClearStudyPlan" style="@style/ScienceSecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/science_planner_btn_clear" android:textColor="@color/science_error" android:visibility="gone" android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
