<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background">
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="90dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/science_app_bar_height" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding">
    <ImageButton android:id="@+id/buttonScienceFormulaBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_back" android:padding="9dp" android:src="@drawable/ic_science_back" app:tint="@color/science_formula_color" />
    <TextView style="@style/ScienceScreenTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/science_formula_title" android:textColor="@color/science_formula_color" />
    <ImageButton android:id="@+id/buttonScienceFormulaAction" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_search" android:padding="8dp" android:src="@drawable/ic_science_search" app:tint="@color/science_formula_color" />
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="4dp" android:layout_marginEnd="@dimen/science_page_padding" android:background="@drawable/science_hero_orange" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/science_hero_height" android:paddingTop="20dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="8dp" android:layout_weight="1">
        <TextView style="@style/ScienceHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/science_formula_hero_title" android:textColor="@color/science_formula_color" />
        <TextView style="@style/ScienceHeroDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/science_formula_hero_description" />
    </LinearLayout>

    <ImageView android:layout_width="64dp" android:layout_height="76dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp" android:contentDescription="@string/science_formula_hero_title" android:padding="8dp" android:src="@drawable/ic_science_book" app:tint="@color/science_formula_color" />
</LinearLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:clipToPadding="false" android:overScrollMode="never" android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/chipFormulaAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/science_chip_orange" android:text="@string/science_formula_all" android:textColor="@color/science_white" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/chipFormulaPhysics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/science_chip_unselected" android:text="@string/science_formula_physics" android:textColor="@color/science_text_secondary" android:textSize="14sp" /><TextView android:id="@+id/chipFormulaChemistry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/science_chip_unselected" android:text="@string/science_formula_chemistry" android:textColor="@color/science_text_secondary" android:textSize="14sp" /><TextView android:id="@+id/chipFormulaBiology" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/science_chip_unselected" android:text="@string/science_formula_biology" android:textColor="@color/science_text_secondary" android:textSize="14sp" /></LinearLayout></HorizontalScrollView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="18dp" android:layout_marginEnd="20dp" android:text="@string/science_my_notes" android:textColor="@color/science_text_primary" android:textSize="18sp" android:textStyle="bold" />
<TextView android:id="@+id/textScienceNotesEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp" android:text="@string/science_notes_empty" android:textColor="@color/science_text_secondary" android:textSize="14sp" />
<LinearLayout android:id="@+id/containerScienceNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp" android:orientation="vertical" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="18dp" android:layout_marginEnd="20dp" android:text="@string/science_ref_formulas" android:textColor="@color/science_text_primary" android:textSize="18sp" android:textStyle="bold" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerScienceFormulas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="12dp" android:layout_marginEnd="@dimen/science_page_padding" android:nestedScrollingEnabled="false" />
</LinearLayout></androidx.core.widget.NestedScrollView>
<ImageButton android:id="@+id/buttonAddScienceFormula" android:layout_width="58dp" android:layout_height="58dp" android:layout_gravity="bottom|end" android:layout_marginEnd="22dp" android:layout_marginBottom="22dp" android:background="@drawable/science_formula_fab" android:contentDescription="@string/science_add_formula" android:elevation="8dp" android:padding="16dp" android:src="@drawable/ic_science_add" />
</FrameLayout>