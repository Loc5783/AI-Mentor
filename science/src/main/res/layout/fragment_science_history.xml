<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/science_app_bar_height" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding">
    <ImageButton android:id="@+id/buttonScienceHistoryBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_back" android:padding="9dp" android:src="@drawable/ic_science_back" app:tint="@color/science_history_color" />
    <TextView style="@style/ScienceScreenTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/science_history_title" android:textColor="@color/science_history_color" />
    <ImageButton android:id="@+id/buttonScienceHistoryAction" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_search" android:padding="8dp" android:src="@drawable/ic_science_search" app:tint="@color/science_history_color" />
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="4dp" android:layout_marginEnd="@dimen/science_page_padding" android:background="@drawable/science_hero_green" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/science_hero_height" android:paddingTop="20dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="8dp" android:layout_weight="1">
        <TextView style="@style/ScienceHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/science_history_hero_title" android:textColor="@color/science_history_color" />
        <TextView style="@style/ScienceHeroDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/science_history_hero_description" />
    </LinearLayout>
    <ImageView android:layout_width="64dp" android:layout_height="76dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp" android:contentDescription="@string/science_history_hero_title" android:padding="8dp" android:src="@drawable/ic_science_calendar" app:tint="@color/science_history_color" />
</LinearLayout>
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:clipToPadding="false" android:overScrollMode="never" android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/chipHistoryAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/science_chip_green" android:text="@string/science_all" android:textColor="@color/science_white" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/chipHistoryToday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/science_chip_unselected" android:text="@string/science_today" android:textColor="@color/science_text_secondary" android:textSize="14sp" /><TextView android:id="@+id/chipHistorySevenDays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/science_chip_unselected" android:text="@string/science_last_seven_days" android:textColor="@color/science_text_secondary" android:textSize="14sp" /><TextView android:id="@+id/chipHistoryMonth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/science_chip_unselected" android:text="@string/science_this_month" android:textColor="@color/science_text_secondary" android:textSize="14sp" /><ImageButton android:id="@+id/buttonScienceHistoryFilter" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="10dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_filter" android:padding="10dp" android:src="@drawable/ic_science_filter" app:tint="@color/science_text_secondary" /></LinearLayout></HorizontalScrollView>
<TextView style="@style/ScienceSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="22dp" android:text="@string/science_today" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerScienceHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="8dp" android:layout_marginEnd="@dimen/science_page_padding" android:nestedScrollingEnabled="false" />
</LinearLayout></androidx.core.widget.NestedScrollView>