<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/science_background" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/science_app_bar_height"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding">
    <ImageButton android:id="@+id/buttonHomeBack" android:layout_width="40dp" android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_back"
        android:padding="9dp" android:src="@drawable/ic_science_back" app:tint="@color/science_home_color" />
    <TextView style="@style/ScienceScreenTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="@string/science_home_title" android:textColor="@color/science_home_color" />
    <ImageButton android:id="@+id/buttonHomeAction" android:layout_width="40dp" android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_nav_history"
        android:padding="8dp" android:src="@drawable/ic_science_history" app:tint="@color/science_home_color" />
</LinearLayout>

<FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/science_hero_height"
    android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="4dp"
    android:layout_marginEnd="@dimen/science_page_padding" android:background="@drawable/science_hero_home">
    <LinearLayout android:layout_width="220dp" android:layout_height="match_parent" android:gravity="center_vertical"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="8dp">
        <TextView style="@style/ScienceHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/science_home_hero_title" android:textColor="@color/science_home_color" />
        <TextView style="@style/ScienceHeroDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/science_home_hero_description" />
    </LinearLayout>
    <ImageView android:layout_width="126dp" android:layout_height="150dp" android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="15dp" android:contentDescription="@string/science_home_hero_title" android:padding="20dp"
        android:src="@drawable/ic_science_chemistry" app:tint="@color/science_home_color" />
</FrameLayout>
<TextView style="@style/ScienceSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="@dimen/science_section_spacing" android:text="@string/science_subjects" />
<LinearLayout android:layout_width="match_parent" android:layout_height="168dp" android:layout_marginStart="14dp"
    android:layout_marginTop="10dp" android:layout_marginEnd="14dp" android:orientation="horizontal">
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardHomePhysics" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="@dimen/science_card_radius" app:cardElevation="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="10dp">
            <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/science_icon_bg_blue" android:padding="14dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_physics" android:src="@drawable/ic_science_physics" app:tint="@color/science_solve_color" /></FrameLayout>
            <TextView style="@style/ScienceMenuCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/science_physics" />
            <TextView style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:maxLines="2" android:text="@string/science_physics_description" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardHomeChemistry" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="@dimen/science_card_radius" app:cardElevation="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="10dp">
            <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/science_icon_bg_green" android:padding="14dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_chemistry" android:src="@drawable/ic_science_chemistry" app:tint="@color/science_history_color" /></FrameLayout>
            <TextView style="@style/ScienceMenuCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/science_chemistry" />
            <TextView style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:maxLines="2" android:text="@string/science_chemistry_description" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardHomeBiology" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="@dimen/science_card_radius" app:cardElevation="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="10dp">
            <FrameLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/science_icon_bg_purple" android:padding="14dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_biology" android:src="@drawable/ic_science_biology" app:tint="@color/science_quiz_color" /></FrameLayout>
            <TextView style="@style/ScienceMenuCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="@string/science_biology" />
            <TextView style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:maxLines="2" android:text="@string/science_biology_description" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
<TextView style="@style/ScienceSectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="@dimen/science_section_spacing" android:text="@string/science_quick_tools" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="10dp" android:layout_marginEnd="@dimen/science_page_padding" android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardHomePeriodicTable" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="@dimen/science_small_card_radius" app:cardElevation="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp"><FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/science_icon_bg_green" android:padding="12dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_periodic_table" android:src="@drawable/ic_science_formula" app:tint="@color/science_history_color" /></FrameLayout><TextView style="@style/ScienceMenuCardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/science_periodic_table" /><ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_science_arrow_right" app:tint="@color/science_nav_unselected" /></LinearLayout></com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardHomeCircuit" android:layout_width="match_parent" android:layout_height="76dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="@dimen/science_small_card_radius" app:cardElevation="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp"><FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/science_icon_bg_blue" android:padding="12dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_circuit" android:src="@drawable/ic_science_circuit" app:tint="@color/science_solve_color" /></FrameLayout><TextView style="@style/ScienceMenuCardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="@string/science_circuit" /><ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_science_arrow_right" app:tint="@color/science_nav_unselected" /></LinearLayout></com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardHomeProgress" android:layout_width="match_parent" android:layout_height="96dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="@dimen/science_small_card_radius" app:cardElevation="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp"><FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/science_icon_bg_purple" android:padding="12dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_progress" android:src="@drawable/ic_science_progress" app:tint="@color/science_quiz_color" /></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/ScienceMenuCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/science_progress" /><TextView android:id="@+id/tvHomeScienceExp" style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/science_total_exp_format" android:textColor="@color/science_quiz_color" /></LinearLayout><ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="@null" android:src="@drawable/ic_science_arrow_right" app:tint="@color/science_nav_unselected" /></LinearLayout></com.google.android.material.card.MaterialCardView>
</LinearLayout>
</LinearLayout></androidx.core.widget.NestedScrollView>
