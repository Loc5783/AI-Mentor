<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/science_app_bar_height" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding">

            <ImageButton android:id="@+id/buttonScienceQuizBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_back" android:padding="9dp" android:src="@drawable/ic_science_back" app:tint="@color/science_quiz_color" />

            <TextView style="@style/ScienceScreenTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/science_quiz_title" android:textColor="@color/science_quiz_color" />

            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/science_quiz_title" android:padding="8dp" android:src="@drawable/ic_science_trophy" app:tint="@color/science_quiz_color" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="4dp" android:layout_marginEnd="@dimen/science_page_padding" android:background="@drawable/science_hero_purple" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="@dimen/science_hero_height" android:paddingTop="20dp" android:paddingBottom="20dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="8dp" android:layout_weight="1">

                <TextView style="@style/ScienceHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/science_quiz_hero_title" android:textColor="@color/science_quiz_color" />

                <TextView style="@style/ScienceHeroDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/science_quiz_hero_description" />
            </LinearLayout>

            <FrameLayout android:layout_width="64dp" android:layout_height="76dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp" android:background="@drawable/science_quiz_hero_icon_background" android:contentDescription="@string/science_quiz_hero_title" android:padding="8dp">

                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_science_checklist" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="12dp" android:layout_marginEnd="@dimen/science_page_padding" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="20dp" app:cardElevation="1dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

                    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="@null" android:padding="7dp" android:src="@drawable/ic_science_trophy" app:tint="@color/science_quiz_color" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">

                        <TextView android:id="@+id/tvScienceQuizLevelTitle" style="@style/ScienceMenuCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/science_level_1" android:textColor="@color/science_quiz_color" />

                        <TextView android:id="@+id/tvScienceQuizTotalExp" style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/science_total_exp_format" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar android:id="@+id/progressScienceQuizLevel" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressBackgroundTint="@color/science_progress_track" android:progressTint="@color/science_quiz_color" />

                <TextView android:id="@+id/tvScienceQuizLevelProgress" style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="" />

                <TextView style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/science_quiz_rewards" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/science_section_spacing" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding">

            <TextView style="@style/ScienceSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/science_select_topic" />

            <TextView android:id="@+id/buttonViewAllQuizTopics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:text="@string/science_view_all" android:textColor="@color/science_quiz_color" android:textSize="14sp" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="4dp" android:layout_marginEnd="@dimen/science_page_padding" android:text="@string/science_quiz_accuracy_explanation" android:textColor="@color/science_text_secondary" android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerScienceQuizTopics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginTop="8dp" android:layout_marginEnd="14dp" android:nestedScrollingEnabled="false" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/science_section_spacing" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding">

            <TextView style="@style/ScienceSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/science_recent_quiz" />

            <TextView android:id="@+id/buttonViewAllRecentQuiz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:text="@string/science_view_all" android:textColor="@color/science_quiz_color" android:textSize="14sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerScienceRecentQuiz" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="8dp" android:layout_marginEnd="@dimen/science_page_padding" android:nestedScrollingEnabled="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
