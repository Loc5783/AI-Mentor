<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/science_background" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/science_app_bar_height"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding">
    <ImageButton android:id="@+id/buttonScienceSolveBack" android:layout_width="40dp" android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_back"
        android:padding="9dp" android:src="@drawable/ic_science_back" app:tint="@color/science_solve_color" />
    <TextView style="@style/ScienceScreenTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:text="@string/science_solve_title" android:textColor="@color/science_solve_color" />
    <ImageButton android:id="@+id/buttonScienceSolveAction" android:layout_width="40dp" android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/science_nav_history"
        android:padding="8dp" android:src="@drawable/ic_science_history" app:tint="@color/science_solve_color" />
</LinearLayout>

<FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/science_hero_height"
    android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="4dp"
    android:layout_marginEnd="@dimen/science_page_padding" android:background="@drawable/science_hero_blue">
    <LinearLayout android:layout_width="220dp" android:layout_height="match_parent" android:gravity="center_vertical"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="8dp">
        <TextView style="@style/ScienceHeroTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/science_solve_hero_title" android:textColor="@color/science_solve_color" />
        <TextView style="@style/ScienceHeroDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/science_solve_hero_description" />
    </LinearLayout>
    <ImageView android:layout_width="126dp" android:layout_height="150dp" android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="15dp" android:contentDescription="@string/science_solve_hero_title" android:padding="20dp"
        android:src="@drawable/ic_science_chemistry" app:tint="@color/science_solve_color" />
</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="12dp" android:layout_marginEnd="@dimen/science_page_padding" android:orientation="horizontal">
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardScienceCamera" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="@dimen/science_card_radius" app:cardElevation="2dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16dp"><FrameLayout android:layout_width="68dp" android:layout_height="62dp" android:background="@drawable/science_icon_bg_blue" android:padding="15dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_take_photo" android:src="@drawable/ic_science_camera" app:tint="@color/science_solve_color" /></FrameLayout><TextView style="@style/ScienceMenuCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/science_take_photo" android:textColor="@color/science_solve_color" /><TextView style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="@string/science_take_photo_description" /></LinearLayout></com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardScienceTextInput" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="6dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/science_surface" app:cardCornerRadius="@dimen/science_card_radius" app:cardElevation="2dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="16dp"><FrameLayout android:layout_width="68dp" android:layout_height="62dp" android:background="@drawable/science_icon_bg_blue" android:padding="15dp"><ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/science_enter_question" android:src="@drawable/ic_science_keyboard" app:tint="@color/science_solve_color" /></FrameLayout><TextView style="@style/ScienceMenuCardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/science_enter_question" android:textColor="@color/science_solve_color" /><TextView style="@style/ScienceMenuCardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="@string/science_enter_question_description" /></LinearLayout></com.google.android.material.card.MaterialCardView>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/science_section_spacing" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/science_page_padding" android:paddingEnd="@dimen/science_page_padding"><TextView style="@style/ScienceSectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/science_recent_questions" /><TextView android:id="@+id/buttonScienceViewAllHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:text="@string/science_view_all" android:textColor="@color/science_solve_color" android:textSize="14sp" /></LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerScienceRecentQuestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/science_page_padding" android:layout_marginTop="8dp" android:layout_marginEnd="@dimen/science_page_padding" android:nestedScrollingEnabled="false" />
</LinearLayout></androidx.core.widget.NestedScrollView>
