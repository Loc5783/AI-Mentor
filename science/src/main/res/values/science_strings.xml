    <string name="science_circuit_series_desc">Trong mạch nối tiếp, tất cả các linh kiện dùng chung một đường dẫn dòng điện. Cùng một dòng điện đi qua điện trở và bóng đèn, trong khi điện áp nguồn được chia sẻ.</string>
    <string name="science_circuit_parallel_desc">Trong mạch song song, mỗi nhánh có cùng hiệu điện thế. Dòng điện có thể chia giữa các nhánh, nên một bóng đèn có thể tiếp tục hoạt động nếu một nhánh khác bị ngắt.</string>
    <string name="science_circuit_switch_closed_desc"> Công tắc đóng làm kín mạch, nên dòng điện quy ước có thể chạy qua.</string>
    <string name="science_circuit_switch_open_desc"> Công tắc mở làm ngắt mạch, nên dòng điện không thể chạy qua.</string>
