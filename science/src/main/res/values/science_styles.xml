<resources>
    <style name="Theme.ScienceFeature" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/science_primary</item>
        <item name="colorOnPrimary">@color/science_on_primary</item>
        <item name="colorPrimaryContainer">@color/mentor_science_container</item>
        <item name="colorSurface">@color/science_surface</item>
        <item name="colorOnSurface">@color/science_text_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/science_surface</item>
        <item name="android:statusBarColor">@color/science_background</item>
        <item name="android:fontFamily">sans-serif</item>
    <item name="android:windowBackground">@color/science_background</item><item name="android:textColorPrimary">@color/science_text_primary</item><item name="android:textColorSecondary">@color/science_text_secondary</item><item name="materialButtonStyle">@style/MentorScienceButton</item><item name="textInputStyle">@style/MentorScienceInput</item><item name="android:windowAnimationStyle">@style/MentorWindowAnimation</item><item name="colorOnPrimaryContainer">@color/science_text_primary</item></style>

    <style name="ScienceHeaderTitle"><item name="android:textColor">@color/science_text_primary</item><item name="android:textSize">21sp</item><item name="android:textStyle">bold</item></style>
    <style name="ScienceBodyText"><item name="android:textColor">@color/science_text_primary</item><item name="android:textSize">16sp</item></style>
    <style name="ScienceSecondaryText"><item name="android:textColor">@color/science_text_secondary</item><item name="android:textSize">15sp</item></style>

    <style name="SciencePrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item><item name="android:textColor">@color/science_on_primary</item>
        <item name="backgroundTint">@color/science_primary</item><item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item><item name="android:textSize">15sp</item>
    </style>
    <style name="ScienceSecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item><item name="android:textColor">@color/science_primary_dark</item>
        <item name="strokeColor">@color/science_border</item><item name="cornerRadius">14dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item>
    </style>
    <style name="ScienceSquareIconButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">@dimen/science_icon_button_size</item><item name="android:layout_height">@dimen/science_icon_button_size</item>
        <item name="android:minWidth">@dimen/science_icon_button_size</item><item name="android:minHeight">@dimen/science_icon_button_size</item>
        <item name="android:padding">0dp</item><item name="android:textColor">@color/science_text_primary</item>
        <item name="strokeColor">@color/science_border</item><item name="backgroundTint">@color/science_surface</item>
        <item name="cornerRadius">14dp</item><item name="android:textAllCaps">false</item>
    </style>
    <style name="ChatToolButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">@dimen/science_tool_button_width</item><item name="android:layout_height">@dimen/science_control_height</item>
        <item name="android:layout_marginEnd">8dp</item><item name="android:minWidth">@dimen/science_tool_button_width</item>
        <item name="android:textColor">@color/science_text_primary</item><item name="strokeColor">@color/science_border</item>
        <item name="backgroundTint">@color/science_surface</item><item name="cornerRadius">14dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item>
    </style>
    <style name="ChatSuggestionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">8dp</item><item name="android:textColor">@color/science_text_primary</item>
        <item name="strokeColor">@color/science_border</item><item name="backgroundTint">@color/science_surface</item>
        <item name="cornerRadius">16dp</item><item name="android:textAllCaps">false</item><item name="android:gravity">start|center_vertical</item><item name="android:textSize">15sp</item>
    </style>
    <style name="ScienceStatCard">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/science_panel</item><item name="android:padding">16dp</item>
        <item name="android:textColor">@color/science_text_primary</item><item name="android:textSize">16sp</item>
    </style>
    <style name="ScienceSubjectRadio">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">52dp</item><item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item><item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/science_option_background</item><item name="android:button">@null</item>
        <item name="android:gravity">center</item><item name="android:minWidth">48dp</item><item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item><item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/science_option_text</item><item name="android:textStyle">bold</item><item name="android:textSize">14sp</item>
    </style>
    <style name="ChatMessageActionButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">48dp</item><item name="android:minWidth">64dp</item>
        <item name="android:minHeight">48dp</item><item name="android:textColor">@color/science_primary_dark</item><item name="android:textAllCaps">false</item><item name="android:textSize">14sp</item>
    </style>

    <style name="ScienceScreenTitle"><item name="android:textSize">22sp</item><item name="android:textStyle">bold</item><item name="android:gravity">center</item></style>
    <style name="ScienceSectionTitle"><item name="android:textColor">@color/science_text_primary</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item></style>
    <style name="ScienceHeroTitle"><item name="android:textColor">@color/science_text_primary</item><item name="android:textSize">21sp</item><item name="android:textStyle">bold</item></style>
    <style name="ScienceHeroDescription"><item name="android:textColor">@color/science_text_secondary</item><item name="android:textSize">15sp</item><item name="android:lineSpacingExtra">3dp</item></style>
    <style name="ScienceMenuCardTitle"><item name="android:textColor">@color/science_text_primary</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="ScienceMenuCardDescription"><item name="android:textColor">@color/science_text_secondary</item><item name="android:textSize">14sp</item><item name="android:lineSpacingExtra">2dp</item></style>
    <style name="ScienceListTitle"><item name="android:textColor">@color/science_text_primary</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item></style>
    <style name="ScienceListSubtitle"><item name="android:textColor">@color/science_text_secondary</item><item name="android:textSize">14sp</item></style>
    <style name="ScienceBottomNavigationTextActive">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ScienceBottomNavigationTextInactive">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

</resources>
