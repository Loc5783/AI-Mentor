<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:focusable="true" android:focusableInTouchMode="true" android:orientation="vertical" android:background="@color/mentor_quiz_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/mentor_quiz_surface" android:paddingStart="8dp" android:paddingEnd="16dp" android:minHeight="56dp">
        <ImageButton android:id="@+id/mentor_quiz_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/mentor_ic_back" android:tint="@color/mentor_quiz_text" android:contentDescription="@string/mentor_quiz_back" />
        <TextView android:id="@+id/mentor_quiz_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/mentor_quiz_title" android:textSize="18sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="@color/mentor_quiz_text" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <com.example.mentor.ui.QuizSetupView android:id="@+id/mentor_quiz_setup" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mentor_quiz_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/mentor_quiz_secondary" android:accessibilityLiveRegion="polite" />
            <com.example.mentor.ui.QuizFormView android:id="@+id/mentor_quiz_form" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
